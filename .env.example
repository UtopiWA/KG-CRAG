KG_CRAG_LLM_MAX_OUTPUT_TOKENS=1600
KG_CRAG_LLM_REASONING_EFFORT=provider-default
KG_CRAG_EMBEDDING_PROVIDER=sentence-transformers
KG_CRAG_EMBEDDING_MODEL=BAAI/bge-m3
