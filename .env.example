KG_CRAG_LIVE_SPARSE_INDEX_VERSION=
KG_CRAG_LIVE_CORPUS_SNAPSHOT=
KG_CRAG_LIVE_PRELOAD_MODELS=false
KG_CRAG_LIVE_ENABLE_GRAPH=true
KG_CRAG_LIVE_ENABLE_RERANKER=true
KG_CRAG_LIVE_ENABLE_ANSWER_CRITIC=true
KG_CRAG_LIVE_PAPER_CONTEXT_LIMIT=5
KG_CRAG_APPLICATION_MEMORY_TARGET_MB=10240
KG_CRAG_APPLICATION_MEMORY_HARD_LIMIT_MB=12288

KG_CRAG_QDRANT_URL=http://localhost:6333
KG_CRAG_QDRANT_API_KEY=
