KG_CRAG_ENV=development
KG_CRAG_LOG_LEVEL=INFO
KG_CRAG_API_HOST=0.0.0.0
KG_CRAG_API_PORT=8000
KG_CRAG_API_REQUEST_TIMEOUT_SECONDS=120
KG_CRAG_API_MAX_TRACE_EVENTS=100
KG_CRAG_API_MAX_PDF_BYTES=52428800
KG_CRAG_REPLAY_FIXTURE_PATH=src/kg_crag/application/replay_cases.json
KG_CRAG_UI_API_BASE_URL=http://127.0.0.1:8000
KG_CRAG_UI_HOST=0.0.0.0
KG_CRAG_UI_PORT=7860
KG_CRAG_ENABLE_LIVE_QUERY=false
KG_CRAG_LIVE_RETRIEVAL_CONFIG_PATH=configs/retrieval.yaml
