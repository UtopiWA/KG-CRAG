{
  "$defs": {
    "ErrorCode": {
      "description": "供调用方稳定分支的错误代码。",
      "enum": [
        "validation_error",
        "configuration_error",
        "external_service_error",
        "timeout_error",
        "not_found",
        "data_error",
        "internal_error"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "description": "可安全序列化的统一错误详情。",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "context": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxProperties": 32,
          "title": "Context",
          "type": "object"
        },
        "message": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "EvaluationResourceUsage": {
      "additionalProperties": false,
      "properties": {
        "estimated_cost": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Cost"
        },
        "input_tokens": {
          "default": 0,
          "maximum": 10000000,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "judge_calls": {
          "default": 0,
          "maximum": 50,
          "minimum": 0,
          "title": "Judge Calls",
          "type": "integer"
        },
        "latency_ms": {
          "default": 0,
          "maximum": 86400000,
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "model_calls": {
          "default": 0,
          "maximum": 1000,
          "minimum": 0,
          "title": "Model Calls",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "maximum": 10000000,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "tool_calls": {
          "default": 0,
          "maximum": 10000,
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        },
        "web_calls": {
          "default": 0,
          "maximum": 100,
          "minimum": 0,
          "title": "Web Calls",
          "type": "integer"
        }
      },
      "title": "EvaluationResourceUsage",
      "type": "object"
    },
    "EvaluationStageStatus": {
      "enum": [
        "pending",
        "succeeded",
        "failed",
        "skipped",
        "budget_stopped"
      ],
      "title": "EvaluationStageStatus",
      "type": "string"
    },
    "StrategyObservation": {
      "additionalProperties": false,
      "properties": {
        "action_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Action Ids",
          "type": "array"
        },
        "cited_evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Cited Evidence Ids",
          "type": "array"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorDetail"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "final_covered_facet_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Final Covered Facet Ids",
          "type": "array"
        },
        "initial_covered_facet_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Initial Covered Facet Ids",
          "type": "array"
        },
        "loop_count": {
          "default": 0,
          "maximum": 10,
          "minimum": 0,
          "title": "Loop Count",
          "type": "integer"
        },
        "matched_answer_point_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Matched Answer Point Ids",
          "type": "array"
        },
        "predicted_sufficient": {
          "default": false,
          "title": "Predicted Sufficient",
          "type": "boolean"
        },
        "question_id": {
          "pattern": "^ueq-[a-z0-9-]{3,120}$",
          "title": "Question Id",
          "type": "string"
        },
        "ranked_evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Ranked Evidence Ids",
          "type": "array"
        },
        "route": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route"
        },
        "status": {
          "$ref": "#/$defs/EvaluationStageStatus"
        },
        "strategy": {
          "$ref": "#/$defs/UnifiedStrategy"
        },
        "usage": {
          "$ref": "#/$defs/EvaluationResourceUsage"
        },
        "web_used": {
          "default": false,
          "title": "Web Used",
          "type": "boolean"
        }
      },
      "required": [
        "question_id",
        "strategy",
        "status"
      ],
      "title": "StrategyObservation",
      "type": "object"
    },
    "UnifiedStrategy": {
      "enum": [
        "fixed_hybrid",
        "type_router",
        "facet_corrective"
      ],
      "title": "UnifiedStrategy",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "dataset_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Dataset Hash",
      "type": "string"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/StrategyObservation"
      },
      "maxItems": 300,
      "minItems": 1,
      "title": "Observations",
      "type": "array"
    },
    "schema_version": {
      "const": "v1",
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "maxProperties": 50,
      "minProperties": 1,
      "title": "Source Versions",
      "type": "object"
    },
    "split_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Split Hash",
      "type": "string"
    }
  },
  "required": [
    "dataset_hash",
    "split_hash",
    "source_versions",
    "observations"
  ],
  "title": "StrategyObservationSet",
  "type": "object"
}
