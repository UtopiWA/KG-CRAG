{
  "$defs": {
    "ErrorCode": {
      "description": "供调用方稳定分支的错误代码。",
      "enum": [
        "validation_error",
        "configuration_error",
        "external_service_error",
        "timeout_error",
        "not_found",
        "data_error",
        "internal_error"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "description": "可安全序列化的统一错误详情。",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "context": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxProperties": 32,
          "title": "Context",
          "type": "object"
        },
        "message": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "IngestionItemResult": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Artifacts",
          "type": "object"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorDetail"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "paper_id": {
          "minLength": 1,
          "title": "Paper Id",
          "type": "string"
        },
        "processing_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Processing Version"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "status": {
          "$ref": "#/$defs/IngestionStatus"
        },
        "warning_count": {
          "default": 0,
          "minimum": 0,
          "title": "Warning Count",
          "type": "integer"
        }
      },
      "required": [
        "paper_id",
        "status"
      ],
      "title": "IngestionItemResult",
      "type": "object"
    },
    "IngestionStatus": {
      "enum": [
        "planned",
        "succeeded",
        "skipped",
        "failed"
      ],
      "title": "IngestionStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "config_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Config Hash",
      "type": "string"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/IngestionItemResult"
      },
      "title": "Items",
      "type": "array"
    },
    "mode": {
      "enum": [
        "pilot",
        "selected",
        "all",
        "dry-run"
      ],
      "title": "Mode",
      "type": "string"
    },
    "pilot_manifest_hash": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pilot Manifest Hash"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "v1",
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "mode",
    "config_hash",
    "started_at",
    "finished_at",
    "items"
  ],
  "title": "IngestionRunManifest",
  "type": "object"
}
