{
  "$defs": {
    "ActionEstimate": {
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "default": 0,
          "maximum": 10000,
          "minimum": 0,
          "title": "Candidates",
          "type": "integer"
        },
        "context_chars": {
          "default": 0,
          "maximum": 1000000,
          "minimum": 0,
          "title": "Context Chars",
          "type": "integer"
        },
        "expected_required_facet_gain": {
          "default": 0.0,
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Expected Required Facet Gain",
          "type": "number"
        },
        "input_tokens": {
          "default": 0,
          "maximum": 20000,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "latency_ms": {
          "default": 0,
          "maximum": 3600000,
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "llm_calls": {
          "default": 0,
          "maximum": 4,
          "minimum": 0,
          "title": "Llm Calls",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "maximum": 20000,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "retrieval_rounds": {
          "default": 0,
          "maximum": 2,
          "minimum": 0,
          "title": "Retrieval Rounds",
          "type": "integer"
        },
        "subquestions": {
          "default": 0,
          "maximum": 3,
          "minimum": 0,
          "title": "Subquestions",
          "type": "integer"
        }
      },
      "title": "ActionEstimate",
      "type": "object"
    },
    "ActionRequest": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/CorrectionAction"
        },
        "action_id": {
          "pattern": "^action-[a-f0-9]{16}$",
          "title": "Action Id",
          "type": "string"
        },
        "filters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "maxProperties": 10,
          "title": "Filters",
          "type": "object"
        },
        "max_candidates": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Candidates",
          "type": "integer"
        },
        "max_hops": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Max Hops",
          "type": "integer"
        },
        "query": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "subqueries": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Subqueries",
          "type": "array"
        },
        "target_facet_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Target Facet Ids",
          "type": "array"
        },
        "top_k": {
          "default": 10,
          "maximum": 100,
          "minimum": 1,
          "title": "Top K",
          "type": "integer"
        }
      },
      "required": [
        "action_id",
        "action",
        "target_facet_ids",
        "query"
      ],
      "title": "ActionRequest",
      "type": "object"
    },
    "ActionResult": {
      "additionalProperties": false,
      "properties": {
        "actual_usage": {
          "$ref": "#/$defs/BudgetUsage"
        },
        "diagnostics": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Diagnostics",
          "type": "object"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorDetail"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "estimated_usage": {
          "$ref": "#/$defs/ActionEstimate"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 100,
          "title": "Evidence",
          "type": "array"
        },
        "request": {
          "$ref": "#/$defs/ActionRequest"
        },
        "status": {
          "$ref": "#/$defs/ActionStatus"
        }
      },
      "required": [
        "request",
        "status",
        "estimated_usage",
        "actual_usage"
      ],
      "title": "ActionResult",
      "type": "object"
    },
    "ActionStatus": {
      "enum": [
        "succeeded",
        "empty",
        "failed",
        "cache_hit"
      ],
      "title": "ActionStatus",
      "type": "string"
    },
    "BudgetLedger": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "$ref": "#/$defs/BudgetLimit"
        },
        "reserved": {
          "$ref": "#/$defs/BudgetUsage"
        },
        "used": {
          "$ref": "#/$defs/BudgetUsage"
        }
      },
      "title": "BudgetLedger",
      "type": "object"
    },
    "BudgetLimit": {
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "default": 100,
          "maximum": 10000,
          "minimum": 1,
          "title": "Candidates",
          "type": "integer"
        },
        "context_chars": {
          "default": 20000,
          "maximum": 1000000,
          "minimum": 1,
          "title": "Context Chars",
          "type": "integer"
        },
        "input_tokens": {
          "default": 16000,
          "maximum": 20000,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "latency_ms": {
          "default": 30000,
          "maximum": 3600000,
          "minimum": 1,
          "title": "Latency Ms",
          "type": "integer"
        },
        "llm_calls": {
          "default": 4,
          "maximum": 4,
          "minimum": 0,
          "title": "Llm Calls",
          "type": "integer"
        },
        "output_tokens": {
          "default": 4000,
          "maximum": 20000,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "retrieval_rounds": {
          "default": 2,
          "maximum": 2,
          "minimum": 1,
          "title": "Retrieval Rounds",
          "type": "integer"
        },
        "subquestions": {
          "default": 3,
          "maximum": 3,
          "minimum": 0,
          "title": "Subquestions",
          "type": "integer"
        }
      },
      "title": "BudgetLimit",
      "type": "object"
    },
    "BudgetUsage": {
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "default": 0,
          "maximum": 10000,
          "minimum": 0,
          "title": "Candidates",
          "type": "integer"
        },
        "context_chars": {
          "default": 0,
          "maximum": 1000000,
          "minimum": 0,
          "title": "Context Chars",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "maximum": 20000,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "latency_ms": {
          "default": 0,
          "maximum": 3600000,
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "llm_calls": {
          "default": 0,
          "maximum": 4,
          "minimum": 0,
          "title": "Llm Calls",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "maximum": 20000,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "retrieval_rounds": {
          "default": 0,
          "maximum": 2,
          "minimum": 0,
          "title": "Retrieval Rounds",
          "type": "integer"
        },
        "subquestions": {
          "default": 0,
          "maximum": 3,
          "minimum": 0,
          "title": "Subquestions",
          "type": "integer"
        }
      },
      "title": "BudgetUsage",
      "type": "object"
    },
    "ConditionKind": {
      "enum": [
        "terms",
        "entity",
        "paper",
        "evidence_type",
        "graph_path",
        "numeric"
      ],
      "title": "ConditionKind",
      "type": "string"
    },
    "ConflictKind": {
      "enum": [
        "discrete",
        "numeric",
        "negation",
        "unknown_unit"
      ],
      "title": "ConflictKind",
      "type": "string"
    },
    "CorrectionAction": {
      "enum": [
        "dense",
        "sparse",
        "hybrid",
        "graph",
        "rewrite",
        "decompose",
        "adjust"
      ],
      "title": "CorrectionAction",
      "type": "string"
    },
    "CorrectionDecision": {
      "additionalProperties": false,
      "properties": {
        "candidate_action_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Candidate Action Ids",
          "type": "array"
        },
        "decision_id": {
          "pattern": "^decision-[a-f0-9]{16}$",
          "title": "Decision Id",
          "type": "string"
        },
        "estimate": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActionEstimate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason_code": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Reason Code",
          "type": "string"
        },
        "rejected_reasons": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 20,
          "title": "Rejected Reasons",
          "type": "object"
        },
        "selected": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActionRequest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stop_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/StopReason"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "utility": {
          "title": "Utility",
          "type": "number"
        }
      },
      "required": [
        "decision_id",
        "utility",
        "reason_code"
      ],
      "title": "CorrectionDecision",
      "type": "object"
    },
    "CoverageMatrix": {
      "additionalProperties": false,
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/FacetCoverage"
          },
          "title": "Entries",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "facet_ids": {
          "items": {
            "type": "string"
          },
          "title": "Facet Ids",
          "type": "array"
        },
        "matrix_id": {
          "pattern": "^matrix-[a-f0-9]{16}$",
          "title": "Matrix Id",
          "type": "string"
        },
        "rule_version": {
          "minLength": 1,
          "title": "Rule Version",
          "type": "string"
        }
      },
      "required": [
        "matrix_id",
        "rule_version",
        "facet_ids",
        "evidence_ids",
        "entries"
      ],
      "title": "CoverageMatrix",
      "type": "object"
    },
    "CoverageStatus": {
      "enum": [
        "matched",
        "not_matched",
        "invalid_source",
        "external_excluded",
        "review_required"
      ],
      "title": "CoverageStatus",
      "type": "string"
    },
    "ErrorCode": {
      "description": "供调用方稳定分支的错误代码。",
      "enum": [
        "validation_error",
        "configuration_error",
        "external_service_error",
        "timeout_error",
        "not_found",
        "data_error",
        "internal_error"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "description": "可安全序列化的统一错误详情。",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "context": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxProperties": 32,
          "title": "Context",
          "type": "object"
        },
        "message": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "external": {
          "default": false,
          "title": "External",
          "type": "boolean"
        },
        "location": {
          "$ref": "#/$defs/EvidenceLocation"
        },
        "metadata": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Metadata",
          "type": "object"
        },
        "paper_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paper Id"
        },
        "ranks": {
          "$ref": "#/$defs/EvidenceRanks"
        },
        "scores": {
          "$ref": "#/$defs/EvidenceScores"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_type": {
          "$ref": "#/$defs/EvidenceSourceType"
        }
      },
      "required": [
        "evidence_id",
        "content",
        "source_type",
        "source_id"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceConflict": {
      "additionalProperties": false,
      "properties": {
        "blocking": {
          "default": true,
          "title": "Blocking",
          "type": "boolean"
        },
        "conflict_id": {
          "pattern": "^conflict-[a-f0-9]{16}$",
          "title": "Conflict Id",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 2,
          "title": "Evidence Ids",
          "type": "array"
        },
        "facet_id": {
          "pattern": "^facet-[a-f0-9]{16}$",
          "title": "Facet Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ConflictKind"
        },
        "reason": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "review_required": {
          "default": false,
          "title": "Review Required",
          "type": "boolean"
        }
      },
      "required": [
        "conflict_id",
        "facet_id",
        "kind",
        "evidence_ids",
        "reason"
      ],
      "title": "EvidenceConflict",
      "type": "object"
    },
    "EvidenceLocation": {
      "additionalProperties": false,
      "properties": {
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "title": "EvidenceLocation",
      "type": "object"
    },
    "EvidenceRanks": {
      "additionalProperties": false,
      "properties": {
        "dense": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dense"
        },
        "fusion": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fusion"
        },
        "rerank": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rerank"
        },
        "sparse": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sparse"
        }
      },
      "title": "EvidenceRanks",
      "type": "object"
    },
    "EvidenceRequirement": {
      "additionalProperties": false,
      "properties": {
        "condition": {
          "$ref": "#/$defs/SatisfactionCondition"
        },
        "confidence": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "expected_evidence_types": {
          "items": {
            "$ref": "#/$defs/EvidenceSourceType"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Expected Evidence Types",
          "type": "array"
        },
        "facet_id": {
          "pattern": "^facet-[a-f0-9]{16}$",
          "title": "Facet Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FacetKind"
        },
        "question_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Question Id",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/RequirementSource",
          "default": "rule"
        },
        "target_entity": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Entity"
        }
      },
      "required": [
        "facet_id",
        "question_id",
        "kind",
        "description",
        "expected_evidence_types",
        "condition"
      ],
      "title": "EvidenceRequirement",
      "type": "object"
    },
    "EvidenceScores": {
      "additionalProperties": false,
      "properties": {
        "dense": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dense"
        },
        "fusion": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fusion"
        },
        "graph": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Graph"
        },
        "rerank": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rerank"
        },
        "sparse": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sparse"
        }
      },
      "title": "EvidenceScores",
      "type": "object"
    },
    "EvidenceSourceType": {
      "enum": [
        "chunk",
        "graph",
        "web"
      ],
      "title": "EvidenceSourceType",
      "type": "string"
    },
    "FacetAssessment": {
      "additionalProperties": false,
      "properties": {
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "facet_id": {
          "pattern": "^facet-[a-f0-9]{16}$",
          "title": "Facet Id",
          "type": "string"
        },
        "reason": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "satisfied": {
          "title": "Satisfied",
          "type": "boolean"
        },
        "support_strength": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Support Strength",
          "type": "number"
        }
      },
      "required": [
        "facet_id",
        "required",
        "satisfied",
        "reason"
      ],
      "title": "FacetAssessment",
      "type": "object"
    },
    "FacetCoverage": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Basis",
          "type": "array"
        },
        "conflict": {
          "default": false,
          "title": "Conflict",
          "type": "boolean"
        },
        "coverage_id": {
          "pattern": "^coverage-[a-f0-9]{16}$",
          "title": "Coverage Id",
          "type": "string"
        },
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "facet_id": {
          "pattern": "^facet-[a-f0-9]{16}$",
          "title": "Facet Id",
          "type": "string"
        },
        "matched": {
          "title": "Matched",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
