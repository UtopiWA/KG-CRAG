{
  "$defs": {
    "AnswerClaim": {
      "additionalProperties": false,
      "properties": {
        "citation_ids": {
          "items": {
            "type": "string"
          },
          "title": "Citation Ids",
          "type": "array"
        },
        "claim_type": {
          "$ref": "#/$defs/ClaimType"
        },
        "text": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "claim_type"
      ],
      "title": "AnswerClaim",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "citation_id": {
          "pattern": "^E[1-9][0-9]*$",
          "title": "Citation Id",
          "type": "string"
        },
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "paper_id": {
          "minLength": 1,
          "title": "Paper Id",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "citation_id",
        "evidence_id",
        "source_id",
        "paper_id"
      ],
      "title": "Citation",
      "type": "object"
    },
    "ClaimType": {
      "enum": [
        "fact",
        "synthesis",
        "inference",
        "uncertain",
        "conflict"
      ],
      "title": "ClaimType",
      "type": "string"
    },
    "ErrorCode": {
      "description": "供调用方稳定分支的错误代码。",
      "enum": [
        "validation_error",
        "configuration_error",
        "external_service_error",
        "timeout_error",
        "not_found",
        "data_error",
        "internal_error"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "description": "可安全序列化的统一错误详情。",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "context": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxProperties": 32,
          "title": "Context",
          "type": "object"
        },
        "message": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "external": {
          "default": false,
          "title": "External",
          "type": "boolean"
        },
        "location": {
          "$ref": "#/$defs/EvidenceLocation"
        },
        "metadata": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Metadata",
          "type": "object"
        },
        "paper_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paper Id"
        },
        "ranks": {
          "$ref": "#/$defs/EvidenceRanks"
        },
        "scores": {
          "$ref": "#/$defs/EvidenceScores"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_type": {
          "$ref": "#/$defs/EvidenceSourceType"
        }
      },
      "required": [
        "evidence_id",
        "content",
        "source_type",
        "source_id"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceLocation": {
      "additionalProperties": false,
      "properties": {
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "title": "EvidenceLocation",
      "type": "object"
    },
    "EvidenceRanks": {
      "additionalProperties": false,
      "properties": {
        "dense": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dense"
        },
        "fusion": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fusion"
        },
        "rerank": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rerank"
        },
        "sparse": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sparse"
        }
      },
      "title": "EvidenceRanks",
      "type": "object"
    },
    "EvidenceScores": {
      "additionalProperties": false,
      "properties": {
        "dense": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dense"
        },
        "fusion": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fusion"
        },
        "graph": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Graph"
        },
        "rerank": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rerank"
        },
        "sparse": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sparse"
        }
      },
      "title": "EvidenceScores",
      "type": "object"
    },
    "EvidenceSourceType": {
      "enum": [
        "chunk",
        "graph",
        "web"
      ],
      "title": "EvidenceSourceType",
      "type": "string"
    },
    "HybridRetrievalResult": {
      "additionalProperties": false,
      "properties": {
        "collection_version": {
          "minLength": 1,
          "title": "Collection Version",
          "type": "string"
        },
        "config_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Hash",
          "type": "string"
        },
        "corpus_snapshot_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Corpus Snapshot Hash",
          "type": "string"
        },
        "costs": {
          "$ref": "#/$defs/RetrievalCostSummary"
        },
        "degraded": {
          "default": false,
          "title": "Degraded",
          "type": "boolean"
        },
        "degraded_stages": {
          "items": {
            "enum": [
              "dense",
              "sparse",
              "rerank"
            ],
            "type": "string"
          },
          "title": "Degraded Stages",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "fusion_version": {
          "minLength": 1,
          "title": "Fusion Version",
          "type": "string"
        },
        "query": {
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "query_id": {
          "minLength": 1,
          "title": "Query Id",
          "type": "string"
        },
        "reranker_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reranker Version"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "sparse_index_version": {
          "minLength": 1,
          "title": "Sparse Index Version",
          "type": "string"
        },
        "stages": {
          "items": {
            "$ref": "#/$defs/RetrievalStageSummary"
          },
          "title": "Stages",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "query_id",
        "query",
        "config_hash",
        "corpus_snapshot_hash",
        "collection_version",
        "sparse_index_version",
        "fusion_version"
      ],
      "title": "HybridRetrievalResult",
      "type": "object"
    },
    "RetrievalCostSummary": {
      "additionalProperties": false,
      "properties": {
        "embedding_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Embedding Calls",
          "type": "integer"
        },
        "llm_calls": {
          "const": 0,
          "default": 0,
          "title": "Llm Calls",
          "type": "integer"
        },
        "local_reranker_latency_ms": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Local Reranker Latency Ms",
          "type": "number"
        },
        "reranker_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Reranker Calls",
          "type": "integer"
        },
        "sparse_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Sparse Calls",
          "type": "integer"
        }
      },
      "title": "RetrievalCostSummary",
      "type": "object"
    },
    "RetrievalStageStatus": {
      "enum": [
        "succeeded",
        "empty",
        "failed",
        "skipped"
      ],
      "title": "RetrievalStageStatus",
      "type": "string"
    },
    "RetrievalStageSummary": {
      "additionalProperties": false,
      "properties": {
        "call_count": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Call Count",
          "type": "integer"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorDetail"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "input_candidates": {
          "default": 0,
          "minimum": 0,
          "title": "Input Candidates",
          "type": "integer"
        },
        "latency_ms": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Latency Ms",
          "type": "number"
        },
        "output_candidates": {
          "default": 0,
          "minimum": 0,
          "title": "Output Candidates",
          "type": "integer"
        },
        "stage": {
          "enum": [
            "dense",
            "sparse",
            "fusion",
            "rerank"
          ],
          "title": "Stage",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/RetrievalStageStatus"
        }
      },
      "required": [
        "stage",
        "status"
      ],
      "title": "RetrievalStageSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "一次 Hybrid 查询及其可选的证据约束回答。",
  "properties": {
    "answer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Answer"
    },
    "citations": {
      "items": {
        "$ref": "#/$defs/Citation"
      },
      "title": "Citations",
      "type": "array"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/AnswerClaim"
      },
      "title": "Claims",
      "type": "array"
    },
    "confidence": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "insufficient_evidence": {
      "default": false,
      "title": "Insufficient Evidence",
      "type": "boolean"
    },
    "llm_calls": {
      "default": 0,
      "enum": [
        0,
        1
      ],
      "title": "Llm Calls",
      "type": "integer"
    },
    "prompt_version": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Version"
    },
    "question": {
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "retrieval": {
      "$ref": "#/$defs/HybridRetrievalResult"
    },
    "retrieval_path": {
      "items": {
        "enum": [
          "dense",
          "sparse"
        ],
        "type": "string"
      },
      "maxItems": 2,
      "minItems": 1,
      "title": "Retrieval Path",
      "type": "array"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "with_answer": {
      "default": false,
      "title": "With Answer",
      "type": "boolean"
    }
  },
  "required": [
    "run_id",
    "question",
    "retrieval",
    "retrieval_path"
  ],
  "title": "HybridQueryResult",
  "type": "object"
}
